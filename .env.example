# Conexão do Postgres. Local (docker-compose): postgres://grisomaq:SENHA@db:5432/grisomaq
POSTGRES_URL="postgres://grisomaq:troque_esta_senha@db:5432/grisomaq"

# Senha do usuário Postgres (usada pelo docker-compose ao subir o container do banco)
POSTGRES_PASSWORD="troque_esta_senha"

# Chave que assina o cookie de sessão. GERE UMA nova em produção!
# Ex.: `openssl rand -base64 32`
AUTH_SECRET="troque-por-uma-chave-aleatoria-longa-e-secreta"

# Senha inicial do admin (só usada na primeira vez que o seed rodar)
ADMIN_SENHA="grisomaq123"

# Rodar seed automático no start (0 pra desativar depois do primeiro deploy)
SEED_ADMIN="1"

# Onde salvar uploads (fotos de peça, NF). Dentro do container:
UPLOAD_DIR="/data/uploads"
NEXT_PUBLIC_UPLOAD_BASE_URL="/api/uploads"
